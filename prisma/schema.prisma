generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  email                  String         @unique
  phone                  String?
  description            String?
  address                String?
  logoUrl                String?        // Logo o imagen del negocio (URL o Base64)
  currency               String         @default("USD")
  plan                   String         @default("FREE") // "FREE" | "PRO"
  active                 Boolean        @default(true)
  adminPin               String         @default("1234")
  autoRemindersEnabled   Boolean        @default(true)
  reminderTiming         String         @default("2_HOURS_BEFORE") // "1_HOUR_BEFORE", "2_HOURS_BEFORE", "24_HOURS_BEFORE"
  reminderMessageTemplate String?
  liveStatus             String         @default("OPEN") // "OPEN", "LUNCH", "CLOSED_TODAY", "SPECIAL_NOTICE"
  statusMessage          String?        // Novedad o mensaje de estado visible para los clientes
  category               String         @default("BARBERIA") // "BARBERIA", "MANICURA_SPA", "LAVADERO", "SALUD_CONSULTORIO", "OTRO"
  serviceModality        String         @default("LOCAL") // "LOCAL", "DOMICILIO", "HIBRIDO"
  smsEnabled             Boolean        @default(false)
  smsUsername            String?        @default("director@appzplay.online")
  smsApiToken            String?
  smsSenderId            String?        @default("TurnoYa")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  partnerId              String?
  partner                Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  services               Service[]
  appointments           Appointment[]
  workingHours           WorkingHour[]
  expenses               Expense[]
  products               Product[]
  productSales           ProductSale[]
  partnerCommissions     PartnerCommission[]
}

model Service {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int           @default(30)
  price           Float         @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments Appointment[]
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Domingo, 1 = Lunes, ..., 6 = Sabado
  openTime   String   @default("09:00") // Formato "HH:mm"
  closeTime  String   @default("19:00") // Formato "HH:mm"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
}

model Appointment {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String
  clientEmail  String?
  clientNotes  String?
  appointmentType String @default("LOCAL") // "LOCAL", "DOMICILIO"
  clientAddress   String? // Dirección en caso de servicio a domicilio
  paymentMethod   String?   @default("EFECTIVO") // "EFECTIVO", "NEQUI", "BANCOLOMBIA", "TARJETA"
  date         DateTime  // Dia de la cita (UTC midnight o fecha seleccionada)
  startTime    String    // "14:30"
  endTime      String    // "15:00"
  status       String    @default("CONFIRMED") // "PENDING", "CONFIRMED", "COMPLETED", "CANCELLED"
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  category    String   @default("INSUMOS") // "INSUMOS", "TRANSPORTE", "SERVICIOS", "ARRIENDO", "OTRO"
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float         @default(0)
  costPrice   Float?        @default(0)
  stock       Int           @default(0)
  category    String        @default("GENERAL") // "CUIDADO", "BELLEZA", "ACCESORIOS", "GENERAL"
  imageUrl    String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sales       ProductSale[]
}

model ProductSale {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int       @default(1)
  unitPrice     Float
  total         Float
  paymentMethod String    @default("EFECTIVO") // "EFECTIVO", "NEQUI", "BANCOLOMBIA", "TARJETA"
  clientName    String?
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

model Partner {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  phone           String              // WhatsApp para coordinar retiros y avisos
  referralCode    String              @unique // ej: "CARLOS10", "PRO-BOGOTA"
  commissionRate  Float               @default(0.20) // Comisión recurrente vitalicia personalizada
  balance         Float               @default(0)    // Saldo disponible para retirar
  totalEarned     Float               @default(0)    // Total acumulado histórico ganado
  payoutMethod    String              @default("NEQUI") // "NEQUI", "DAVIPLATA", "BANCOLOMBIA", "PAYPAL", "EFECTIVO"
  payoutAccount   String?             // Número de celular o cuenta
  status          String              @default("ACTIVE") // "ACTIVE", "PAUSED"
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  referredBusinesses Business[]
  commissions        PartnerCommission[]
  payouts            PartnerPayout[]
}

model PartnerCommission {
  id                 String    @id @default(cuid())
  partnerId          String
  partner            Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionAmount Float     // Monto del pago de la suscripción (ej: 60000 COP o 19 USD)
  commissionRate     Float     // Tasa aplicada personalizada (ej: 0.20 para 20%)
  amount             Float     // Comisión ganada (calculada con su tasa asignada)
  description        String    // ej: "Comisión mensual recurrente Plan PRO"
  createdAt          DateTime  @default(now())
}

model PartnerPayout {
  id            String    @id @default(cuid())
  partnerId     String
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount        Float
  payoutMethod  String
  payoutAccount String
  status        String    @default("REQUESTED") // "REQUESTED", "PAID", "REJECTED"
  reference     String?   // Comprobante de pago / ID de transferencia
  notes         String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
}

