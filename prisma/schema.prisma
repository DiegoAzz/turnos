generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  email                  String         @unique
  phone                  String?
  description            String?
  address                String?
  logoUrl                String?        // Logo o imagen del negocio (URL o Base64)
  currency               String         @default("USD")
  plan                   String         @default("FREE") // "FREE" | "PRO"
  active                 Boolean        @default(true)
  adminPin               String         @default("1234")
  autoRemindersEnabled   Boolean        @default(true)
  reminderTiming         String         @default("2_HOURS_BEFORE") // "1_HOUR_BEFORE", "2_HOURS_BEFORE", "24_HOURS_BEFORE"
  reminderMessageTemplate String?
  liveStatus             String         @default("OPEN") // "OPEN", "LUNCH", "CLOSED_TODAY", "SPECIAL_NOTICE"
  statusMessage          String?        // Novedad o mensaje de estado visible para los clientes
  category               String         @default("BARBERIA") // "BARBERIA", "MANICURA_SPA", "LAVADERO", "SALUD_CONSULTORIO", "OTRO"
  serviceModality        String         @default("LOCAL") // "LOCAL", "DOMICILIO", "HIBRIDO"
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  services     Service[]
  appointments Appointment[]
  workingHours WorkingHour[]
  expenses     Expense[]
  products     Product[]
  productSales ProductSale[]
}

model Service {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int           @default(30)
  price           Float         @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments Appointment[]
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Domingo, 1 = Lunes, ..., 6 = Sabado
  openTime   String   @default("09:00") // Formato "HH:mm"
  closeTime  String   @default("19:00") // Formato "HH:mm"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
}

model Appointment {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String
  clientEmail  String?
  clientNotes  String?
  appointmentType String @default("LOCAL") // "LOCAL", "DOMICILIO"
  clientAddress   String? // Dirección en caso de servicio a domicilio
  paymentMethod   String?   @default("EFECTIVO") // "EFECTIVO", "NEQUI", "BANCOLOMBIA", "TARJETA"
  date         DateTime  // Dia de la cita (UTC midnight o fecha seleccionada)
  startTime    String    // "14:30"
  endTime      String    // "15:00"
  status       String    @default("CONFIRMED") // "PENDING", "CONFIRMED", "COMPLETED", "CANCELLED"
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  category    String   @default("INSUMOS") // "INSUMOS", "TRANSPORTE", "SERVICIOS", "ARRIENDO", "OTRO"
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float         @default(0)
  costPrice   Float?        @default(0)
  stock       Int           @default(0)
  category    String        @default("GENERAL") // "CUIDADO", "BELLEZA", "ACCESORIOS", "GENERAL"
  imageUrl    String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sales       ProductSale[]
}

model ProductSale {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int       @default(1)
  unitPrice     Float
  total         Float
  paymentMethod String    @default("EFECTIVO") // "EFECTIVO", "NEQUI", "BANCOLOMBIA", "TARJETA"
  clientName    String?
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

