generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  email                  String         @unique
  phone                  String?
  description            String?
  address                String?
  logoUrl                String?        // Logo o imagen del negocio (URL o Base64)
  currency               String         @default("USD")
  plan                   String         @default("FREE") // "FREE" | "PRO"
  active                 Boolean        @default(true)
  adminPin               String         @default("1234")
  autoRemindersEnabled   Boolean        @default(true)
  reminderTiming         String         @default("2_HOURS_BEFORE") // "1_HOUR_BEFORE", "2_HOURS_BEFORE", "24_HOURS_BEFORE"
  reminderMessageTemplate String?
  liveStatus             String         @default("OPEN") // "OPEN", "LUNCH", "CLOSED_TODAY", "SPECIAL_NOTICE"
  statusMessage          String?        // Novedad o mensaje de estado visible para los clientes
  category               String         @default("BARBERIA") // "BARBERIA", "MANICURA_SPA", "LAVADERO", "SALUD_CONSULTORIO", "OTRO"
  serviceModality        String         @default("LOCAL") // "LOCAL", "DOMICILIO", "HIBRIDO"
  smsEnabled             Boolean        @default(false)
  smsUsername            String?        @default("director@appzplay.online")
  smsApiToken            String?
  smsSenderId            String?        @default("TurnoYa")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  partnerId              String?
  partner                Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  services               Service[]
  appointments           Appointment[]
  workingHours           WorkingHour[]
  expenses               Expense[]
  products               Product[]
  productSales           ProductSale[]
  partnerCommissions     PartnerCommission[]

  @@index([partnerId])
  @@index([active])
}

model Service {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int           @default(30)
  price           Float         @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments Appointment[]
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Domingo, 1 = Lunes, ..., 6 = Sabado
  openTime   String   @default("09:00") // Formato "HH:mm"
  closeTime  String   @default("19:00") // Formato "HH:mm"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
}

model Appointment {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String
  clientEmail  String?
  clientNotes  String?
  appointmentType String @default("LOCAL") // "LOCAL", "DOMICILIO"
  clientAddress   String? // Dirección en caso de servicio a domicilio
  paymentMethod   String?   @default("EFECTIVO") // "EFECTIVO", "NEQUI", "BANCOLOMBIA", "TARJETA"
  date         DateTime  // Dia de la cita (UTC midnight o fecha seleccionada)
  startTime    String    // "14:30"
  endTime      String    // "15:00"
  status       String    @default("CONFIRMED") // "PENDING", "CONFIRMED", "COMPLETED", "CANCELLED"
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, date])
  @@index([businessId, status])
  @@index([date, reminderSent])
  @@index([clientPhone])
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  category    String   @default("INSUMOS") // "INSUMOS", "TRANSPORTE", "SERVICIOS", "ARRIENDO", "OTRO"
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([businessId, date])
}

model Product {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float         @default(0)
  costPrice   Float?        @default(0)
  stock       Int           @default(0)
  category    String        @default("GENERAL") // "CUIDADO", "BELLEZA", "ACCESORIOS", "GENERAL"
  imageUrl    String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sales       ProductSale[]

  @@index([businessId, active])
}

model ProductSale {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int       @default(1)
  unitPrice     Float
  total         Float
  paymentMethod String    @default("EFECTIVO") // "EFECTIVO", "NEQUI", "BANCOLOMBIA", "TARJETA"
  clientName    String?
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([businessId, date])
}

model Partner {
  id                      String              @id @default(cuid())
  name                    String
  email                   String              @unique
  phone                   String              // WhatsApp para coordinar retiros y avisos
  referralCode            String              @unique // ej: "CARLOS10", "PRO-BOGOTA"
  firstMonthCommissionRate Float              @default(0.50) // Bono inicial mayor para el 1er mes (captación)
  commissionRate          Float               @default(0.20) // Comisión recurrente vitalicia personalizada (meses 2+)
  balance                 Float               @default(0)    // Saldo disponible para retirar
  totalEarned             Float               @default(0)    // Total acumulado histórico ganado
  payoutMethod            String              @default("NEQUI") // "NEQUI", "DAVIPLATA", "BANCOLOMBIA", "PAYPAL", "EFECTIVO"
  payoutAccount           String?             // Número de celular o cuenta
  experience              String?             // Observaciones / perfil comercial / experiencia
  status                  String              @default("PENDING") // "PENDING", "ACTIVE", "REJECTED"
  approvedAt              DateTime?

  // Modelo de Franquicia SaaS / Marca Blanca (Inscripción inicial + Mensualidad tecnológica)
  isFranchise             Boolean             @default(false)
  franchiseName           String?             // Nombre comercial de la franquicia (ej: "TurnoYa Medellín")
  franchiseCityCountry    String?             // Ciudad y país (ej: "Medellín, Colombia", "Ciudad de México")
  franchiseEntryFee       Float               @default(0) // Cuota inicial de inscripción / canon de apertura
  franchiseEntryFeePaid   Boolean             @default(false) // Si ya pagó la inscripción inicial
  franchiseMonthlyFee     Float               @default(0) // Mensualidad tecnológica recurrente que paga al creador
  franchiseFeeCurrency    String              @default("USD") // "USD" o "COP"
  franchiseStatus         String              @default("INACTIVE") // "ACTIVE", "PENDING_ENTRY_FEE", "PENDING_MONTHLY", "PAST_DUE", "INACTIVE"
  franchiseDueDate        DateTime?           // Próxima fecha límite de pago de la mensualidad
  franchiseNotes          String?             // Condiciones / acuerdos especiales

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  referredBusinesses Business[]
  commissions        PartnerCommission[]
  payouts            PartnerPayout[]

  @@index([isFranchise])
  @@index([status])
}

model PartnerCommission {
  id                 String    @id @default(cuid())
  partnerId          String
  partner            Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionAmount Float     // Monto del pago de la suscripción (ej: 60000 COP o 19 USD)
  commissionRate     Float     // Tasa aplicada personalizada (ej: 0.50 primer mes, 0.20 meses posteriores)
  amount             Float     // Comisión ganada (calculada con su tasa asignada)
  isFirstMonth       Boolean   @default(false) // Indica si fue bono de captación del primer mes
  monthNumber        Int       @default(1)     // Número de mes de suscripción (1, 2, 3...)
  description        String    // ej: "Bono Inicial 1er Mes (50%) Plan PRO"
  createdAt          DateTime  @default(now())

  @@index([partnerId])
  @@index([businessId])
}

model PartnerPayout {
  id            String    @id @default(cuid())
  partnerId     String
  partner       Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount        Float
  payoutMethod  String
  payoutAccount String
  status        String    @default("REQUESTED") // "REQUESTED", "PAID", "REJECTED"
  reference     String?   // Comprobante de pago / ID de transferencia
  notes         String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([partnerId, status])
}

model PlatformSettings {
  id                    String   @id @default("global")
  paymentMode           String   @default("MANUAL") // "MANUAL" (solo consignación), "GATEWAY" (solo pasarela Wompi/PSE), "HYBRID" (ambas)
  wompiPublicKey        String?  @default("")
  wompiIntegritySecret  String?  @default("")
  wompiSandbox          Boolean  @default(true)
  nequiNumber           String   @default("300 123 4567")
  daviplataNumber       String   @default("300 123 4567")
  bancolombiaDetails    String   @default("Cuenta de Ahorros Bancolombia")
  whatsappPaymentNumber String   @default("300 123 4567")
  proPriceCOP           Int      @default(60000)
  independientePriceCOP Int      @default(35000)
  partnerFirstMonthRate Float    @default(0.50) // Tasa global por defecto 1er mes (ej: 50%)
  partnerRecurringRate  Float    @default(0.20) // Tasa global por defecto meses siguientes (ej: 20%)
  defaultFranchiseEntryFeeUSD Float @default(99) // Inscripción inicial sugerida en USD
  defaultFranchiseEntryFeeCOP Float @default(400000) // Inscripción inicial sugerida en COP
  defaultFranchiseFeeUSD Float   @default(29)   // Mensualidad tecnológica sugerida en USD
  defaultFranchiseFeeCOP Float   @default(100000) // Mensualidad tecnológica sugerida en COP
  updatedAt             DateTime @updatedAt
}

